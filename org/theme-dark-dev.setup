#+HTML_HEAD: <link rel="preconnect" href="https://fonts.googleapis.com">
#+HTML_HEAD: <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
#+HTML_HEAD: <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
#+HTML_HEAD: <style>
#+HTML_HEAD: :root{--bg:#0d1117;--surface:#161b22;--surface2:#1c2129;--border:#30363d;--text:#e6edf3;--text-muted:#8b949e;--accent:#58a6ff;--green:#3fb950;--purple:#bc8cff;--orange:#d29922;--red:#f85149}
#+HTML_HEAD: *{margin:0;padding:0;box-sizing:border-box}
#+HTML_HEAD: body{font-family:'Inter',-apple-system,BlinkMacSystemFont,sans-serif;background:var(--bg);color:var(--text);line-height:1.75;font-size:16px}
#+HTML_HEAD: #content{max-width:820px;margin:0 auto;padding:3rem 2rem}
#+HTML_HEAD: #table-of-contents{position:fixed;left:0;top:0;width:260px;height:100vh;overflow-y:auto;background:var(--surface);border-right:1px solid var(--border);padding:2rem 1.2rem;font-size:0.85rem}
#+HTML_HEAD: #table-of-contents h2{font-family:'JetBrains Mono',monospace;font-size:0.75rem;text-transform:uppercase;letter-spacing:0.1em;color:var(--text-muted);margin-bottom:1rem}
#+HTML_HEAD: #table-of-contents ul{list-style:none;padding-left:0}
#+HTML_HEAD: #table-of-contents li{margin-bottom:0.4rem}
#+HTML_HEAD: #table-of-contents li ul{padding-left:1rem;margin-top:0.4rem}
#+HTML_HEAD: #table-of-contents a{color:var(--text-muted);text-decoration:none;transition:color 0.2s}
#+HTML_HEAD: #table-of-contents a:hover{color:var(--accent)}
#+HTML_HEAD: @media(min-width:1100px){#content{margin-left:280px}}
#+HTML_HEAD: @media(max-width:1099px){#table-of-contents{position:relative;width:100%;height:auto;border-right:none;border-bottom:1px solid var(--border);margin-bottom:2rem}}
#+HTML_HEAD: h1.title{font-size:2.4rem;font-weight:700;margin-bottom:0.5rem;background:linear-gradient(135deg,var(--accent),var(--purple));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
#+HTML_HEAD: h2,h3,h4,h5,h6{font-weight:600;margin-top:2.5rem;margin-bottom:1rem;color:var(--text)}
#+HTML_HEAD: h2{font-size:1.6rem;padding-bottom:0.5rem;border-bottom:1px solid var(--border)}
#+HTML_HEAD: h3{font-size:1.3rem}
#+HTML_HEAD: h4{font-size:1.1rem;color:var(--text-muted)}
#+HTML_HEAD: p{margin-bottom:1.2rem}
#+HTML_HEAD: a{color:var(--accent);text-decoration:none;transition:color 0.2s}
#+HTML_HEAD: a:hover{color:var(--purple);text-decoration:underline}
#+HTML_HEAD: ul,ol{margin-bottom:1.2rem;padding-left:1.5rem}
#+HTML_HEAD: li{margin-bottom:0.4rem}
#+HTML_HEAD: code{font-family:'JetBrains Mono',monospace;font-size:0.88em;background:var(--surface2);border:1px solid var(--border);border-radius:4px;padding:0.15em 0.4em;color:var(--orange)}
#+HTML_HEAD: pre{background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:1.2rem 1.5rem;overflow-x:auto;margin-bottom:1.5rem;font-size:0.88rem;line-height:1.6}
#+HTML_HEAD: pre code{background:none;border:none;padding:0;color:var(--text);font-size:inherit}
#+HTML_HEAD: .org-src-container{position:relative;margin-bottom:1.5rem}
#+HTML_HEAD: .org-src-container>pre{margin:0}
#+HTML_HEAD: .org-src-container label{position:absolute;top:0.5rem;right:0.8rem;font-family:'JetBrains Mono',monospace;font-size:0.7rem;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.05em}
#+HTML_HEAD: blockquote{border-left:3px solid var(--accent);background:var(--surface);padding:1rem 1.5rem;margin:1.5rem 0;border-radius:0 6px 6px 0;color:var(--text-muted);font-style:italic}
#+HTML_HEAD: table{border-collapse:collapse;width:100%;margin-bottom:1.5rem;font-size:0.9rem}
#+HTML_HEAD: th,td{border:1px solid var(--border);padding:0.6rem 1rem;text-align:left}
#+HTML_HEAD: th{background:var(--surface);font-weight:600;color:var(--text-muted)}
#+HTML_HEAD: tr:nth-child(even){background:var(--surface2)}
#+HTML_HEAD: img{max-width:100%;border-radius:8px;border:1px solid var(--border)}
#+HTML_HEAD: .tag span{font-family:'JetBrains Mono',monospace;font-size:0.75rem;background:var(--surface);border:1px solid var(--border);border-radius:4px;padding:0.1em 0.5em;color:var(--green)}
#+HTML_HEAD: .timestamp{font-family:'JetBrains Mono',monospace;color:var(--text-muted);font-size:0.85rem}
#+HTML_HEAD: #postamble{margin-top:4rem;padding-top:2rem;border-top:1px solid var(--border);text-align:center;color:var(--text-muted);font-size:0.8rem;font-family:'JetBrains Mono',monospace}
#+HTML_HEAD: ::selection{background:rgba(88,166,255,0.3)}
#+HTML_HEAD: ::-webkit-scrollbar{width:8px;height:8px}
#+HTML_HEAD: ::-webkit-scrollbar-track{background:var(--bg)}
#+HTML_HEAD: ::-webkit-scrollbar-thumb{background:var(--border);border-radius:4px}
#+HTML_HEAD: ::-webkit-scrollbar-thumb:hover{background:var(--text-muted)}
#+HTML_HEAD: nav.back-home{position:fixed;top:1.2rem;right:1.5rem;z-index:999}
#+HTML_HEAD: nav.back-home a{font-family:'JetBrains Mono',monospace;font-size:0.8rem;color:var(--text-muted);background:var(--surface);border:1px solid var(--border);border-radius:6px;padding:0.4rem 0.8rem;text-decoration:none;transition:all 0.2s}
#+HTML_HEAD: nav.back-home a:hover{color:var(--accent);border-color:var(--accent);text-decoration:none}
#+HTML_HEAD: </style>
#+HTML_HEAD: <nav class="back-home"><a href="index.html">← Home</a></nav>
#+OPTIONS: html-style:nil html5-fancy:t num:nil toc:2
#+HTML_DOCTYPE: html5
